<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">
        <ImageView
            android:id="@+id/w_mark"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="4dp"
            android:src="@drawable/ic_mark"
            android:contentDescription="Dashboard" />
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="Dashboard"
            android:textColor="@color/w_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:textColor="@color/w_muted"
            android:textSize="11sp" />
        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_cats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/c_fav"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/chip_off"
            android:text="★ علاقه‌مندی‌ها"
            android:textColor="@color/w_text"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/c_all"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/chip_off"
            android:text="همه"
            android:textColor="@color/w_text"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/c_game"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/chip_off"
            android:text="گیم"
            android:textColor="@color/w_text"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/c_anime"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/chip_off"
            android:text="انیمه"
            android:textColor="@color/w_text"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/w_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/w_line"
        android:dividerHeight="1dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="@color/w_muted"
        android:textSize="13sp" />
</LinearLayout>
